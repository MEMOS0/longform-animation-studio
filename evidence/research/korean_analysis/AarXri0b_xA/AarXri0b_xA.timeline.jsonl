{"start": 50, "end": 60, "shot_ids": [2, 3, 4], "shot_boundary_count": 2, "visual_mean": {"brightness": 0.2481933444738388, "saturation": 0.36417661756277087, "edge_density": 0.06002267673611641, "colorfulness": 0.3352781757712364, "motion_mean_abs_diff": 0.0765248137526214, "warm_ratio": 0.5954513888888889}, "dialogue_text": "Let's keep it clean this time.", "dialogue_word_count": 6, "audio_rms_mean": 0.02539375238120556, "audio_rms_std": 0.029157282784581184, "audio_spectral_centroid_mean": 1279.7578125, "audio_zero_crossing_rate": 0.07741207817492013, "audio_onsets_per_second": 3.9, "audio_silence_ratio": 0.0}
{"start": 60, "end": 70, "shot_ids": [4, 5], "shot_boundary_count": 1, "visual_mean": {"brightness": 0.2198989361524582, "saturation": 0.2386740893125534, "edge_density": 0.049433476850390436, "colorfulness": 0.3099324494600296, "motion_mean_abs_diff": 0.08737361335661262, "warm_ratio": 0.5812569444444444}, "dialogue_text": "We're expecting a foreign guest. You'll take care of the guest personally for three days.", "dialogue_word_count": 15, "audio_rms_mean": 0.017470665276050568, "audio_rms_std": 0.022963201627135277, "audio_spectral_centroid_mean": 1045.7711181640625, "audio_zero_crossing_rate": 0.06848885533146964, "audio_onsets_per_second": 2.3, "audio_silence_ratio": 0.20766773162939298}
{"start": 70, "end": 80, "shot_ids": [5, 6], "shot_boundary_count": 1, "visual_mean": {"brightness": 0.20180195420980454, "saturation": 0.24938840717077254, "edge_density": 0.03624410964548588, "colorfulness": 0.2999323129653931, "motion_mean_abs_diff": 0.08198187528178096, "warm_ratio": 0.12872222222222224}, "dialogue_text": "Yes, Executive Director. Hải Phòng chỉ là giấy tờ thôi.(Hai Phong is just a name on the paperwork.)", "dialogue_word_count": 23, "audio_rms_mean": 0.037700098007917404, "audio_rms_std": 0.048790715634822845, "audio_spectral_centroid_mean": 839.8566284179688, "audio_zero_crossing_rate": 0.0473024410942492, "audio_onsets_per_second": 2.5, "audio_silence_ratio": 0.09904153354632587}
{"start": 80, "end": 90, "shot_ids": [6], "shot_boundary_count": 0, "visual_mean": {"brightness": 0.15430135354399682, "saturation": 0.2898466855287552, "edge_density": 0.032995700091123584, "colorfulness": 0.2712964743375778, "motion_mean_abs_diff": 0.05429478045552969, "warm_ratio": 0.06307638888888889}, "dialogue_text": "在公海换船，改了船名，进南浦。(They'll switch ships in international waters, rename the vessel, and enter Nampo.)", "dialogue_word_count": 12, "audio_rms_mean": 0.03299199417233467, "audio_rms_std": 0.034343063831329346, "audio_spectral_centroid_mean": 758.2964477539062, "audio_zero_crossing_rate": 0.044120032947284345, "audio_onsets_per_second": 2.4, "audio_silence_ratio": 0.0}
{"start": 90, "end": 100, "shot_ids": [6], "shot_boundary_count": 0, "visual_mean": {"brightness": 0.13704795241355897, "saturation": 0.4273477137088776, "edge_density": 0.027979610301554204, "colorfulness": 0.2665269449353218, "motion_mean_abs_diff": 0.06909254994243383, "warm_ratio": 0.19188194444444445}, "dialogue_text": "在公海换船，改了船名，进南浦。(They'll switch ships in international waters, rename the vessel, and enter Nampo.)", "dialogue_word_count": 12, "audio_rms_mean": 0.039587195962667465, "audio_rms_std": 0.046165842562913895, "audio_spectral_centroid_mean": 775.4635620117188, "audio_zero_crossing_rate": 0.05070948981629393, "audio_onsets_per_second": 1.6, "audio_silence_ratio": 0.0}
{"start": 100, "end": 110, "shot_ids": [6], "shot_boundary_count": 0, "visual_mean": {"brightness": 0.12741582170128823, "saturation": 0.47349835336208346, "edge_density": 0.028963520377874374, "colorfulness": 0.21686825156211853, "motion_mean_abs_diff": 0.0683984586969018, "warm_ratio": 0.2203125}, "dialogue_text": "", "dialogue_word_count": 0, "audio_rms_mean": 0.007668035104870796, "audio_rms_std": 0.0068796174600720406, "audio_spectral_centroid_mean": 1438.254150390625, "audio_zero_crossing_rate": 0.0741719498801917, "audio_onsets_per_second": 2.7, "audio_silence_ratio": 0.3194888178913738}
{"start": 110, "end": 120, "shot_ids": [6], "shot_boundary_count": 0, "visual_mean": {"brightness": 0.10541189685463906, "saturation": 0.4742605835199356, "edge_density": 0.02068096213042736, "colorfulness": 0.21268780827522277, "motion_mean_abs_diff": 0.03780011102790013, "warm_ratio": 0.28170833333333334}, "dialogue_text": "It's not Hai Phong. The cargo gets transferred at sea. Then it goes into Nampo.", "dialogue_word_count": 15, "audio_rms_mean": 0.02789313904941082, "audio_rms_std": 0.03214548900723457, "audio_spectral_centroid_mean": 961.3033447265625, "audio_zero_crossing_rate": 0.06338608226837061, "audio_onsets_per_second": 2.8, "audio_silence_ratio": 0.06070287539936102}
{"start": 120, "end": 130, "shot_ids": [6], "shot_boundary_count": 0, "visual_mean": {"brightness": 0.11749321669340133, "saturation": 0.4993996173143387, "edge_density": 0.022592910937964915, "colorfulness": 0.23264777809381484, "motion_mean_abs_diff": 0.049804948689416054, "warm_ratio": 0.2841944444444444}, "dialogue_text": "Your evidence? The guest's phone call was recorded on the dashcam.", "dialogue_word_count": 11, "audio_rms_mean": 0.024396011605858803, "audio_rms_std": 0.03553546592593193, "audio_spectral_centroid_mean": 1031.6893310546875, "audio_zero_crossing_rate": 0.06615040934504793, "audio_onsets_per_second": 2.7, "audio_silence_ratio": 0.0670926517571885}
{"start": 130, "end": 140, "shot_ids": [6], "shot_boundary_count": 0, "visual_mean": {"brightness": 0.11334274336695671, "saturation": 0.48587739169597627, "edge_density": 0.027469315752387046, "colorfulness": 0.23568849712610246, "motion_mean_abs_diff": 0.05250018420629203, "warm_ratio": 0.5076597222222222}, "dialogue_text": "Stay put for now. A recording of the call in the guest's car... I got a copy of it.", "dialogue_word_count": 19, "audio_rms_mean": 0.02977624721825123, "audio_rms_std": 0.034661684185266495, "audio_spectral_centroid_mean": 1031.373779296875, "audio_zero_crossing_rate": 0.060239554213258786, "audio_onsets_per_second": 3.8, "audio_silence_ratio": 0.03194888178913738}
{"start": 140, "end": 150, "shot_ids": [6], "shot_boundary_count": 0, "visual_mean": {"brightness": 0.10432656332850457, "saturation": 0.3807872235774994, "edge_density": 0.02890283800661564, "colorfulness": 0.2527578011155128, "motion_mean_abs_diff": 0.07579218751052394, "warm_ratio": 0.23905555555555558}, "dialogue_text": "I got a copy of it.", "dialogue_word_count": 6, "audio_rms_mean": 0.01241262350231409, "audio_rms_std": 0.016586221754550934, "audio_spectral_centroid_mean": 909.1723022460938, "audio_zero_crossing_rate": 0.05100433057108626, "audio_onsets_per_second": 1.4, "audio_silence_ratio": 0.07028753993610223}
{"start": 150, "end": 160, "shot_ids": [6, 7], "shot_boundary_count": 1, "visual_mean": {"brightness": 0.12764919102191924, "saturation": 0.32095796167850493, "edge_density": 0.02392542464658618, "colorfulness": 0.2093188926577568, "motion_mean_abs_diff": 0.039993257354944946, "warm_ratio": 0.18804166666666666}, "dialogue_text": "Check the dashcam in the guest's car. Yes, sir. The memory card in the company car's dashcam has been switched.", "dialogue_word_count": 20, "audio_rms_mean": 0.019061006605625153, "audio_rms_std": 0.024660460650920868, "audio_spectral_centroid_mean": 1065.5057373046875, "audio_zero_crossing_rate": 0.06608956918929712, "audio_onsets_per_second": 3.4, "audio_silence_ratio": 0.04153354632587859}
{"start": 160, "end": 170, "shot_ids": [7], "shot_boundary_count": 0, "visual_mean": {"brightness": 0.21438250988721846, "saturation": 0.18582259863615036, "edge_density": 0.039150490611791613, "colorfulness": 0.2711015358567238, "motion_mean_abs_diff": 0.05993403340689838, "warm_ratio": 0.399625}, "dialogue_text": "The memory card in the company car's dashcam has been switched. Who was driving? Team Leader Hyun.", "dialogue_word_count": 17, "audio_rms_mean": 0.015345113351941109, "audio_rms_std": 0.01983598992228508, "audio_spectral_centroid_mean": 1126.5421142578125, "audio_zero_crossing_rate": 0.07344498801916934, "audio_onsets_per_second": 2.8, "audio_silence_ratio": 0.14696485623003194}
{"start": 170, "end": 180, "shot_ids": [7], "shot_boundary_count": 0, "visual_mean": {"brightness": 0.17854296863079072, "saturation": 0.3275008901953697, "edge_density": 0.04014100041240454, "colorfulness": 0.2644613966345787, "motion_mean_abs_diff": 0.07101732989540324, "warm_ratio": 0.4346875}, "dialogue_text": "I only reported it to Manager Seo. Two days later, someone was on my tail.", "dialogue_word_count": 15, "audio_rms_mean": 0.02015121467411518, "audio_rms_std": 0.023663584142923355, "audio_spectral_centroid_mean": 992.822265625, "audio_zero_crossing_rate": 0.062442279852236424, "audio_onsets_per_second": 1.9, "audio_silence_ratio": 0.07348242811501597}
{"start": 180, "end": 190, "shot_ids": [7], "shot_boundary_count": 0, "visual_mean": {"brightness": 0.21623608618974685, "saturation": 0.2120868131518364, "edge_density": 0.03246781136840582, "colorfulness": 0.2908273577690125, "motion_mean_abs_diff": 0.03917308580130339, "warm_ratio": 0.27423611111111107}, "dialogue_text": "Two days later, someone was on my tail. I don't know if it's Manager Seo or someone above him. They're probably already planning to get rid of me.", "dialogue_word_count": 28, "audio_rms_mean": 0.030166013166308403, "audio_rms_std": 0.032833509147167206, "audio_spectral_centroid_mean": 1432.669921875, "audio_zero_crossing_rate": 0.10938748003194888, "audio_onsets_per_second": 3.8, "audio_silence_ratio": 0.10223642172523961}
{"start": 190, "end": 200, "shot_ids": [7], "shot_boundary_count": 0, "visual_mean": {"brightness": 0.22850405871868135, "saturation": 0.21825602203607558, "edge_density": 0.03914448767900467, "colorfulness": 0.28769335001707075, "motion_mean_abs_diff": 0.08064389389473944, "warm_ratio": 0.3234027777777778}, "dialogue_text": "I'll investigate from the outside. You keep watch from within.", "dialogue_word_count": 10, "audio_rms_mean": 0.014867931604385376, "audio_rms_std": 0.019733650609850883, "audio_spectral_centroid_mean": 1168.2406005859375, "audio_zero_crossing_rate": 0.08668006190095846, "audio_onsets_per_second": 2.1, "audio_silence_ratio": 0.19169329073482427}
{"start": 200, "end": 210, "shot_ids": [7], "shot_boundary_count": 0, "visual_mean": {"brightness": 0.24797926992177963, "saturation": 0.20869978219270707, "edge_density": 0.025051847286522388, "colorfulness": 0.25356794744729994, "motion_mean_abs_diff": 0.06114363661035895, "warm_ratio": 0.24229861111111117}, "dialogue_text": "Take care of our Junhee for me. Looks like I'll have to die once.", "dialogue_word_count": 14, "audio_rms_mean": 0.00797491054981947, "audio_rms_std": 0.01086549460887909, "audio_spectral_centroid_mean": 1226.42626953125, "audio_zero_crossing_rate": 0.0827348118011182, "audio_onsets_per_second": 1.3, "audio_silence_ratio": 0.3738019169329074}
{"start": 210, "end": 220, "shot_ids": [7, 8], "shot_boundary_count": 1, "visual_mean": {"brightness": 0.19555259495973587, "saturation": 0.364782352745533, "edge_density": 0.0325979832559824, "colorfulness": 0.23952435404062272, "motion_mean_abs_diff": 0.0748702438082546, "warm_ratio": 0.5218888888888888}, "dialogue_text": "Looks like I'll have to die once. Someone's been following me.", "dialogue_word_count": 11, "audio_rms_mean": 0.013032589107751846, "audio_rms_std": 0.01677730120718479, "audio_spectral_centroid_mean": 1603.486572265625, "audio_zero_crossing_rate": 0.10593987120607029, "audio_onsets_per_second": 3.6, "audio_silence_ratio": 0.24281150159744408}
{"start": 220, "end": 230, "shot_ids": [8], "shot_boundary_count": 0, "visual_mean": {"brightness": 0.16908588111400605, "saturation": 0.44588403403759, "edge_density": 0.03141999691724777, "colorfulness": 0.21692523807287217, "motion_mean_abs_diff": 0.04622121565043926, "warm_ratio": 0.6315208333333334}, "dialogue_text": "Someone's been following me. Was that your order, Executive Director? Our Team Leader Hyun... Maybe you've simply left too long a trail behind you.", "dialogue_word_count": 24, "audio_rms_mean": 0.01796923764050007, "audio_rms_std": 0.018750492483377457, "audio_spectral_centroid_mean": 1320.780517578125, "audio_zero_crossing_rate": 0.09352223941693291, "audio_onsets_per_second": 3.6, "audio_silence_ratio": 0.0926517571884984}
{"start": 230, "end": 240, "shot_ids": [8, 9], "shot_boundary_count": 1, "visual_mean": {"brightness": 0.15438227653503417, "saturation": 0.4232384651899338, "edge_density": 0.0318743753246963, "colorfulness": 0.21602876484394073, "motion_mean_abs_diff": 0.04379933946765959, "warm_ratio": 0.5998541666666668}, "dialogue_text": "I've taken out insurance. I'm not dying alone.", "dialogue_word_count": 8, "audio_rms_mean": 0.015000630170106888, "audio_rms_std": 0.017243169248104095, "audio_spectral_centroid_mean": 1206.06494140625, "audio_zero_crossing_rate": 0.08261157148562301, "audio_onsets_per_second": 1.9, "audio_silence_ratio": 0.1501597444089457}
{"start": 240, "end": 250, "shot_ids": [9], "shot_boundary_count": 0, "visual_mean": {"brightness": 0.12145739570260047, "saturation": 0.24462801218032837, "edge_density": 0.03487700596451759, "colorfulness": 0.23882894366979598, "motion_mean_abs_diff": 0.03713443274609744, "warm_ratio": 0.4178333333333334}, "dialogue_text": "I'm not bluffing. I really made a copy. So if you disappear, it all comes out? Then you'll have to die of your own accord.", "dialogue_word_count": 25, "audio_rms_mean": 0.02460959181189537, "audio_rms_std": 0.03608625382184982, "audio_spectral_centroid_mean": 1211.5924072265625, "audio_zero_crossing_rate": 0.08169740914536741, "audio_onsets_per_second": 3.3, "audio_silence_ratio": 0.2012779552715655}
{"start": 250, "end": 260, "shot_ids": [9, 10], "shot_boundary_count": 1, "visual_mean": {"brightness": 0.1466061666607857, "saturation": 0.3313394784927368, "edge_density": 0.03568469807505607, "colorfulness": 0.22485999763011932, "motion_mean_abs_diff": 0.07336072190664708, "warm_ratio": 0.36524999999999996}, "dialogue_text": "Then you'll have to die of your own accord. First, give yourself a reason to die.", "dialogue_word_count": 16, "audio_rms_mean": 0.021464753895998, "audio_rms_std": 0.03589947521686554, "audio_spectral_centroid_mean": 1092.0726318359375, "audio_zero_crossing_rate": 0.06349060253594249, "audio_onsets_per_second": 3.1, "audio_silence_ratio": 0.17891373801916932}
{"start": 260, "end": 270, "shot_ids": [11], "shot_boundary_count": 1, "visual_mean": {"brightness": 0.16220233589410782, "saturation": 0.5273967236280441, "edge_density": 0.03434470947831869, "colorfulness": 0.2552824079990387, "motion_mean_abs_diff": 0.07785845489706844, "warm_ratio": 0.19729166666666667}, "dialogue_text": "You're back? Would you tell me if I asked why?", "dialogue_word_count": 10, "audio_rms_mean": 0.009582869708538055, "audio_rms_std": 0.015275945886969566, "audio_spectral_centroid_mean": 1359.1611328125, "audio_zero_crossing_rate": 0.07505647214456869, "audio_onsets_per_second": 3.0, "audio_silence_ratio": 0.645367412140575}
{"start": 270, "end": 280, "shot_ids": [11], "shot_boundary_count": 0, "visual_mean": {"brightness": 0.13577632009983062, "saturation": 0.5191089093685151, "edge_density": 0.020977076701819898, "colorfulness": 0.239568093419075, "motion_mean_abs_diff": 0.037351588951423764, "warm_ratio": 0.21639583333333334}, "dialogue_text": "Would you tell me if I asked why? No. I wanted to run away, but I couldn't.", "dialogue_word_count": 17, "audio_rms_mean": 0.01288656797260046, "audio_rms_std": 0.015571913681924343, "audio_spectral_centroid_mean": 1368.06689453125, "audio_zero_crossing_rate": 0.09227735623003194, "audio_onsets_per_second": 3.1, "audio_silence_ratio": 0.44089456869009586}
