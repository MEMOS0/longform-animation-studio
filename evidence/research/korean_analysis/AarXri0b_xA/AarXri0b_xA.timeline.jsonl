{"start": 380, "end": 390, "shot_ids": [13], "shot_boundary_count": 0, "visual_mean": {"brightness": 0.16933612078428267, "saturation": 0.4419866770505905, "edge_density": 0.02114400565624237, "colorfulness": 0.22791064530611038, "motion_mean_abs_diff": 0.05300072797108442, "warm_ratio": 0.294875}, "dialogue_text": "Are we... sex partners? Do you want to be sex partners with me?", "dialogue_word_count": 13, "audio_rms_mean": 0.0138595812022686, "audio_rms_std": 0.015925511717796326, "audio_spectral_centroid_mean": 1222.294677734375, "audio_zero_crossing_rate": 0.08222625049920128, "audio_onsets_per_second": 2.6, "audio_silence_ratio": 0.3003194888178914}
