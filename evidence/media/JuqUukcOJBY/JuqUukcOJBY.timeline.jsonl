{"start": 300, "end": 310, "shot_ids": [12], "shot_boundary_count": 0, "visual_mean": {"brightness": 0.23514912724494935, "saturation": 0.492505818605423, "edge_density": 0.031345915608108045, "colorfulness": 0.2719114288687706, "motion_mean_abs_diff": 0.08266602717339992, "warm_ratio": 0.20031249999999998}, "dialogue_text": "Yes, the gun, on orders from Chief Harlan Frost. Who shot that clerk? I don't know. I never looked. Anything else you want to say? Tell Mrs. Booker Crumble I'm sorry. Not that it fixes anything.", "dialogue_word_count": 36, "audio_rms_mean": 0.055397409945726395, "audio_rms_std": 0.04733576998114586, "audio_spectral_centroid_mean": 1376.219970703125, "audio_zero_crossing_rate": 0.10241894219249201, "audio_onsets_per_second": 5.1, "audio_silence_ratio": 0.30990415335463256}
